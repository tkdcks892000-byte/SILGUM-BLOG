---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SILGUM_URL } from '../consts';
import { withBase } from '../lib/site-paths';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">SILGUM PRODUCT NOTES</p>
				<h1>SILGUM의 기능과<br />데이터 기준을 기록합니다.</h1>
				<p class="intro">
					현재 기능, 데이터 범위, 공개 가능한 제품 변경을 코드와 문서에 근거해 설명합니다.
					SILGUM 안에서 관측한 수치와 외부 자료의 단위를 구분해 씁니다.
				</p>
				<a class="button" href={`${SILGUM_URL}/about`}>SILGUM 알아보기</a>
			</section>

			<section class="recent" aria-labelledby="recent-heading">
				<div class="section-heading">
					<p class="eyebrow">LATEST</p>
					<h2 id="recent-heading">최근 기록</h2>
				</div>
				{posts.length ? (
					<ul class="post-list">
						{posts.map((post) => (
							<li>
								<a href={withBase(`blog/${post.id}/`)}>
									<span>{post.data.title}</span>
									<time datetime={post.data.pubDate.toISOString()}>
										{post.data.pubDate.toLocaleDateString('ko-KR')}
									</time>
								</a>
							</li>
						))}
					</ul>
				) : (
					<p class="empty-state">첫 번째 기록을 준비하고 있습니다.</p>
				)}
			</section>

			<p class="site-note">
				각 글은 확인 가능한 제품 코드·프로젝트 문서·변경 기록에 근거합니다. 기록에서 확인할 수 없는 개인 경험이나
				성과는 추측하지 않습니다.
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		padding-top: clamp(3.5rem, 9vw, 7rem);
	}
	.hero {
		max-width: 48rem;
		padding-bottom: clamp(4rem, 9vw, 7rem);
	}
	.eyebrow {
		margin: 0 0 0.75rem;
		color: var(--accent);
		font-size: 0.75rem;
		font-weight: 750;
		letter-spacing: 0.12em;
	}
	h1 {
		margin: 0;
		font-size: clamp(2.5rem, 7vw, 5rem);
		letter-spacing: -0.06em;
	}
	.intro {
		max-width: 40rem;
		margin: 1.5rem 0 2rem;
		color: var(--muted);
		font-size: clamp(1.05rem, 2vw, 1.3rem);
		line-height: 1.8;
	}
	.button {
		display: inline-block;
		padding: 0.75rem 1.1rem;
		border-radius: 0.5rem;
		background: var(--accent);
		color: white;
		font-size: 0.95rem;
		font-weight: 700;
		text-decoration: none;
	}
	.button:hover {
		background: var(--accent-hover);
		color: white;
	}
	.recent,
	.series {
		padding-block: 2.25rem;
		border-top: 1px solid var(--line);
	}
	.section-heading h2 {
		margin: 0 0 1.25rem;
		font-size: clamp(1.5rem, 3vw, 2rem);
		letter-spacing: -0.035em;
	}
	.post-list,
	.series ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.post-list li,
	.series li {
		border-top: 1px solid var(--line);
	}
	.post-list a,
	.series li {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		padding: 1rem 0;
		color: var(--ink);
		text-decoration: none;
	}
	.post-list a {
		justify-content: space-between;
	}
	.post-list a:hover span {
		color: var(--accent);
	}
	time,
	.empty-state,
	.site-note {
		color: var(--muted);
		font-size: 0.9rem;
	}
	.empty-state {
		padding-block: 1rem;
	}
	.episode {
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 750;
		letter-spacing: 0.08em;
		white-space: nowrap;
	}
	.site-note {
		margin: 1rem 0 0;
		padding-top: 1.25rem;
		border-top: 1px solid var(--line);
		line-height: 1.7;
	}
	@media (max-width: 560px) {
		.post-list a,
		.series li {
			align-items: flex-start;
		}
		.post-list a {
			flex-direction: column;
			gap: 0.35rem;
		}
	}
</style>
