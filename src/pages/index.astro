---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SILGUM_URL } from '../consts';
import { withBase } from '../lib/site-paths';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">SILGUM PRODUCT NOTES</p>
				<h1>실검의 기능과<br />데이터 기준을 기록합니다.</h1>
				<p class="intro">
					지금 화면에서 실제로 되는 일과, 이렇게 쓰면 좋은 방법을 적습니다.
					숫자가 실검 안에서 관측한 값인지 외부 자료인지도 구분해 설명합니다.
				</p>
				<a class="button" href={`${SILGUM_URL}/about`}>실검 알아보기</a>
			</section>

			<section class="recent" aria-labelledby="recent-heading">
				<div class="section-heading">
					<p class="eyebrow">LATEST</p>
					<h2 id="recent-heading">최근 기록</h2>
				</div>
				{posts.length ? (
					<ul class="post-list">
						{posts.map((post) => (
							<li>
								<a href={withBase(`blog/${post.id}/`)}>
									<span>{post.data.title}</span>
									<time datetime={post.data.pubDate.toISOString()}>
										{post.data.pubDate.toLocaleDateString('ko-KR')}
									</time>
								</a>
							</li>
						))}
					</ul>
				) : (
					<p class="empty-state">첫 번째 기록을 준비하고 있습니다.</p>
				)}
			</section>

			<p class="site-note">
				각 글은 확인 가능한 제품 코드·프로젝트 문서·변경 기록에 근거합니다. 기록에서 확인할 수 없는 개인 경험이나
				성과는 추측하지 않습니다.
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		padding-top: clamp(2.25rem, 5vw, 3.25rem);
	}
	.hero {
		max-width: 44rem;
		padding-bottom: clamp(2rem, 4.5vw, 3rem);
	}
	.eyebrow {
		margin: 0 0 0.6rem;
		color: var(--accent);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.14em;
	}
	h1 {
		margin: 0;
		font-size: clamp(1.55rem, 3.1vw, 2.15rem);
		letter-spacing: -0.045em;
	}
	.intro {
		max-width: 38rem;
		margin: 1.1rem 0 1.6rem;
		color: var(--muted);
		font-size: clamp(0.95rem, 1.2vw, 1.02rem);
		line-height: 1.85;
	}
	.button {
		display: inline-block;
		padding: 0.55rem 0.95rem;
		border-radius: 0.5rem;
		background: var(--accent);
		color: #0b1220;
		font-size: 0.88rem;
		font-weight: 700;
		text-decoration: none;
	}
	.button:hover {
		background: var(--accent-hover);
		color: #0b1220;
	}
	.recent,
	.series {
		padding-block: 1.75rem;
		border-top: 1px solid var(--line);
	}
	.section-heading h2 {
		margin: 0 0 0.9rem;
		font-size: clamp(1.15rem, 1.8vw, 1.4rem);
		letter-spacing: -0.03em;
	}
	.post-list,
	.series ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.post-list li,
	.series li {
		border-top: 1px solid var(--line);
	}
	.post-list a,
	.series li {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		padding: 0.8rem 0;
		color: var(--ink);
		text-decoration: none;
	}
	.post-list a {
		justify-content: space-between;
	}
	.post-list a:hover span {
		color: var(--accent);
	}
	time,
	.empty-state,
	.site-note {
		color: var(--muted);
		font-size: 0.85rem;
	}
	.empty-state {
		padding-block: 0.8rem;
	}
	.episode {
		color: var(--accent);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		white-space: nowrap;
	}
	.site-note {
		margin: 0.8rem 0 0;
		padding-top: 1.1rem;
		border-top: 1px solid var(--line);
		line-height: 1.7;
	}
	@media (max-width: 560px) {
		.post-list a,
		.series li {
			align-items: flex-start;
		}
		.post-list a {
			flex-direction: column;
			gap: 0.3rem;
		}
	}
</style>
