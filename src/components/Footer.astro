---
import { SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
---

<footer>© {year} {SITE_TITLE}</footer>
<style>
	footer {
		width: min(100% - 2rem, 68rem);
		margin: 2rem auto 0;
		padding: 1.5rem 0 2rem;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.875rem;
	}
</style>
